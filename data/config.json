{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com/v1",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "languages": ["vi"]
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "xxx@qq.com",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [
      { "type": "repo_releases", "owner": "microsoft",       "repo": "markitdown",   "enabled": true },
      { "type": "repo_releases", "owner": "unstructured-IO", "repo": "unstructured", "enabled": true },
      { "type": "repo_releases", "owner": "vllm-project",    "repo": "vllm",         "enabled": true },
      { "type": "repo_releases", "owner": "huggingface",     "repo": "transformers", "enabled": true },
      { "type": "repo_releases", "owner": "comfyanonymous",  "repo": "ComfyUI",      "enabled": true },
      { "type": "repo_releases", "owner": "openai",          "repo": "whisper",      "enabled": true }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 15,
      "min_score": 100
    },
    "rss": [
      { "name": "Simon Willison",   "url": "https://simonwillison.net/atom/everything/", "enabled": true,  "category": "ai-tools" },
      { "name": "OpenAI News",      "url": "https://openai.com/news/rss.xml",            "enabled": true,  "category": "ai-vendor" },
      { "name": "Google AI Blog",   "url": "https://blog.google/technology/ai/rss/",     "enabled": true,  "category": "ai-vendor" },
      { "name": "ArXiv cs.AI",      "url": "http://export.arxiv.org/rss/cs.AI",          "enabled": true,  "category": "research" },
      { "name": "HuggingFace Blog", "url": "https://huggingface.co/blog/feed.xml",       "enabled": true,  "category": "ai-tools" },
      { "name": "Replicate Blog",   "url": "https://replicate.com/blog/rss",             "enabled": true,  "category": "ai-tools" },
      { "name": "The Rundown AI",   "url": "https://www.therundown.ai/feed",             "enabled": false, "category": "ai-news" },
      { "name": "Anthropic News",   "url": "https://www.anthropic.com/news/rss",         "enabled": false, "category": "ai-vendor" }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        { "subreddit": "MachineLearning",        "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 100 },
        { "subreddit": "LocalLLaMA",             "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 50 },
        { "subreddit": "OpenAI",                 "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 8,  "min_score": 100 },
        { "subreddit": "ChatGPT",                "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 8,  "min_score": 200 },
        { "subreddit": "SaaS",                   "enabled": true, "sort": "top", "time_filter": "day", "fetch_limit": 8,  "min_score": 50 },
        { "subreddit": "EntrepreneurRideAlong",  "enabled": true, "sort": "top", "time_filter": "day", "fetch_limit": 8,  "min_score": 30 }
      ],
      "users": [],
      "fetch_comments": 3
    }
  },
  "filtering": {
    "ai_score_threshold": 7.0,
    "time_window_hours": 24
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": null,
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": { "wide_screen_mode": true },
        "header": {
          "title": { "tag": "plain_text", "content": "#{message_title}" },
          "template": "blue"
        },
        "body": {
          "elements": [
            { "tag": "markdown", "content": "Horizon: #{result}\nImportant items: #{important_items}/#{all_items}" },
            { "tag": "hr" },
            { "tag": "markdown", "content": "#{summary}" }
          ]
        }
      }
    },
    "headers": ""
  }
}
